# Copy to .dev.vars for `wrangler dev`. Placeholder values only; never commit real secrets.
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8787
RUN_WITH_DATABASE=true
DB_USER=vertexia
DB_PASS=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vertexia
DB_TLS=false
DB_TLS_CA_PEM=
DB_TLS_SERVER_NAME=
SESSION_SECURE=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_REQUIRED=false
ALTCHA_HMAC_KEY=replace-with-32-plus-random-characters
REGISTRATION_IP_SALT=replace-with-32-plus-random-characters
GAMESERVER_API_KEY=replace-me
GSM_ENABLED=false
GSM_AGENT_URL=http://127.0.0.1:9000
GSM_AGENT_SECRET=replace-me
NETCODE_PRIVATE_KEY=replace-with-base64-32-byte-key
NETCODE_PROTOCOL_ID=0
R2_ACCOUNT_ID=your-account-id
R2_BUCKET=your-bucket
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_PUBLIC_BASE_URL=https://assets.example.com
TYPESAFE_API_KEY=
SITELOCK_PASSWORD=
INSTANCE_COUNT=1

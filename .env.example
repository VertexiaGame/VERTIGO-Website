######
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vertexia
RUN_WITH_DATABASE=true
##POOLS##
DB_MAX_OPEN_CONNS=25 
DB_MAX_IDLE_CONNS=25
##
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=5m
######

######
#Server will wait before timeout (uploads need headroom on slow connections)
SERVER_READ_TIMEOUT=120s
SERVER_WRITE_TIMEOUT=120s 
SERVER_IDLE_TIMEOUT=60s 
######

######
LIMITER_MAX=1000 #How many requests can one IP make in:
LIMITER_EXPIRATION=1m #this time frame?
######

######
SESSION_SECURE=false
SESSION_SAMESITE=Lax
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=24h
ALTCHA_HMAC_KEY=Please-Put-A-32-Character-Long-HMAC-Secret-Key-Here
GAMESERVER_API_KEY=Please-Put-A-Secure-API-Key-Here

######
#Event. This is the main event on launch of the website. Normally, this should be disabled, and in an future iteration, will be deleted
######
LIVETIMER_ENABLED=false
LIVETIMER_DURATION=10m # How much the event lasts: 1 hour on prod

######
#Site lock. When enabled, visitors must enter the password once before accessing the website.
######
SITELOCK_ENABLED=false
SITELOCK_PASSWORD=

######
#Redis!! for GSM gameserver registry, becayse its faster than mysql and they are all temp
######
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

######
#GSM (Gameserver Manager). Ports span 5100-5250. Public host is what clients dial. Leave GSM_PUBLIC_HOST blank to auto-detect the machine's own IP.
######
GSM_ENABLED=true
GSM_SERVER_BIN=
GSM_SERVER_WORKDIR=
GSM_SERVER_MAP= #temp
GSM_BIND_HOST=127.0.0.1
GSM_PUBLIC_HOST=
GSM_PORT_MIN=5100
GSM_PORT_MAX=5250
GSM_MAX_PLAYERS_DEFAULT=100
GSM_MIN_PLAYERS_DEFAULT=2
GSM_IDLE_TIMEOUT=5m
GSM_REAP_INTERVAL=15s
GSM_SHUTDOWN_GRACE=10s
GSM_SERVER_LOGS_DIR=./logs/gsm
# /etc/vertexia/gsm-agent.env (mode 0640, owner root, group gsm)
# Example values only. Every line marked SECRET must be replaced with a
# freshly generated value and never committed.

# ---- Agent API --------------------------------------------------------------
# Listen address. Use 127.0.0.1:8443 when running behind cloudflared.
GSM_AGENT_LISTEN=:8443
# SECRET: HMAC-SHA256 key shared with the platform (GSM_AGENT_SECRET there).
# At least 32 characters, e.g. generated with: openssl rand -hex 32
GSM_AGENT_SECRET=replace-with-64-hex-chars-from-openssl-rand
# TLS certificate and key (TLS 1.2+). Required unless plain HTTP is allowed.
GSM_AGENT_TLS_CERT=/etc/vertexia/gsm-agent.crt
# SECRET (file): private key path, readable only by root and the gsm group.
GSM_AGENT_TLS_KEY=/etc/vertexia/gsm-agent.key
# Plain HTTP is only accepted with a loopback GSM_AGENT_LISTEN (for a
# cloudflared tunnel terminating TLS on this host).
GSM_AGENT_ALLOW_HTTP=false
# Label for this host; namespaces its Redis records (gsmagent:<id>:...).
GSM_AGENT_ID=games-1

# ---- Gameserver processes --------------------------------------------------
# UDP port range handed to gameservers (open it in the host firewall).
GSM_PORT_RANGE=7000-7099
# Optional cap on concurrent gameservers (0 = limited only by the port range).
GSM_MAX_SERVERS=0
GSM_SERVER_BIN=/opt/vertexia/RaveEngineServer
GSM_SERVER_WORKDIR=/var/lib/gsm-agent
# Default map, passed to --map when a request names none.
GSM_SERVER_MAP=assets/maps/default.vrtx
# Directory that requested maps must resolve inside. Empty disables custom maps.
GSM_MAP_DIR=/opt/vertexia/maps
GSM_SERVER_LOGS_DIR=/var/log/gsm-agent
GSM_BIND_HOST=0.0.0.0
GSM_READY_TIMEOUT=30s
GSM_SHUTDOWN_GRACE=10s
# Restart a crashed gameserver on the same port at most this many times
# within GSM_RESTART_WINDOW, then mark it failed and release the port.
GSM_MAX_RESTARTS=3
GSM_RESTART_WINDOW=10m

# ---- Redis (records + nonce replay protection) ------------------------------
# SECRET: REDIS_URL contains the password. Prefer rediss:// (TLS).
REDIS_URL=rediss://default:replace-with-redis-password@redis.example.internal:6380/0
# Alternative to REDIS_URL:
# REDIS_ADDR=redis.example.internal:6380
# REDIS_PASSWORD=replace-with-redis-password   (SECRET)
# REDIS_TLS=true
# REDIS_DB=0

# ---- Passed through to gameservers ------------------------------------------
# Children receive only PATH, HOME, VERTIGO_APP, VERTIGO_GAME_ID,
# VERTIGO_SERVER_ID, VERTIGO_API_DOMAIN, GAMESERVER_API_KEY,
# NETCODE_PRIVATE_KEY, NETCODE_PROTOCOL_ID and RUST_LOG (if set). The agent
# secret and Redis credentials are never passed on.
# SECRET: 32-byte netcode key as 64 hex chars (same value as the platform).
NETCODE_PRIVATE_KEY=replace-with-64-hex-chars
NETCODE_PROTOCOL_ID=1234567890
# SECRET: gameserver to platform API key (same value as the platform).
GAMESERVER_API_KEY=replace-with-random-secret-of-at-least-32-chars
# Platform origin the gameservers report to.
VERTIGO_API_DOMAIN=https://vertexia.wempos-forum.com
# RUST_LOG=info

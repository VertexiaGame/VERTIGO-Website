DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vertexia
RUN_WITH_DATABASE=true
DB_MAX_OPEN_CONNS=25 
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=5m

SERVER_READ_TIMEOUT=120s
SERVER_WRITE_TIMEOUT=120s 
SERVER_IDLE_TIMEOUT=60s 

TRUST_PROXY=false
TRUSTED_PROXIES=
PROXY_HEADER=

LIMITER_MAX=1000
LIMITER_EXPIRATION=1m

SESSION_SECURE=false
SESSION_SAMESITE=Lax
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=24h
ALTCHA_HMAC_KEY=Please-Put-A-32-Character-Long-HMAC-Secret-Key-Here
REGISTRATION_IP_SALT=Please-Put-A-32-Character-Long-Registration-IP-Salt-Here
GAMESERVER_API_KEY=Please-Put-A-Secure-API-Key-Here

LIVETIMER_ENABLED=false
LIVETIMER_DURATION=10m

SITELOCK_ENABLED=false
SITELOCK_PASSWORD=

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

GSM_ENABLED=true
GSM_SERVER_BIN=
GSM_SERVER_WORKDIR=
GSM_SERVER_MAP= #temp
GSM_BIND_HOST=127.0.0.1
GSM_PUBLIC_HOST=
GSM_PORT_MIN=5100
GSM_PORT_MAX=5250
GSM_MAX_PLAYERS_DEFAULT=100
GSM_MIN_PLAYERS_DEFAULT=2
GSM_IDLE_TIMEOUT=5m
GSM_REAP_INTERVAL=15s
GSM_SHUTDOWN_GRACE=10s
GSM_SERVER_LOGS_DIR=./logs/gsm

FILTER_ENABLED=true
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
FILTER_TIMEOUT=20s